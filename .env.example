# Скопируйте в backend/.env
DATABASE_URL=postgresql+psycopg://acr:acr@127.0.0.1:5432/acr
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_S=240
LLM_TEMPERATURE=0.2
# -1 — держать модель в памяти всегда; например 5m — выгружать после 5 минут простоя
LLM_KEEP_ALIVE=-1
CRM_PROVIDER=mock
